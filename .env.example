# ==============================================================================
# BookMyStudio - Frontend Environment Configuration (.env.example)
# ==============================================================================
# This file documents all environment variables used by the Next.js frontend.
#
# QUICK START FOR LOCAL DEVELOPMENT:
#   1. Copy this file to '.env.local':
#        cp .env.example .env.local
#   2. The default value below works out-of-the-box with the local Express backend.
#
# NEXT.JS ENVIRONMENT PRECEDENCE:
#   .env.local (local overrides, ignored by git)
#   .env.development / .env.production (environment-specific defaults)
#   .env (project defaults)
#
# SECURITY NOTE:
#   Variables prefixed with 'NEXT_PUBLIC_' are embedded into the client-side
#   browser JavaScript bundle at build time. NEVER expose private secrets,
#   database passwords, or backend API keys with NEXT_PUBLIC_ prefixes.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND API URL
# ------------------------------------------------------------------------------
# Purpose:
#   The base HTTP URL of the BookMyStudio Express + MongoDB backend API.
#   All frontend API calls (authentication, listings, bookings, reviews, partner
#   management, and profile endpoints) dispatch requests to this base URL.
#
# Required:
#   - LOCAL DEVELOPMENT: OPTIONAL (Defaults to 'http://localhost:4000/api')
#   - PRODUCTION: REQUIRED (Must point to your deployed backend domain)
#
# Format:
#   Full URL including protocol and trailing '/api' path. No trailing slash.
#
# Examples:
#   - Local Dev:   http://localhost:4000/api
#   - Production:  https://api.bookmystudio.com/api
#   - Render/Fly:  https://bookmystudio-server.onrender.com/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# RUNTIME ENVIRONMENT (MANAGED AUTOMATICALLY BY NEXT.JS)
# ------------------------------------------------------------------------------
# Next.js automatically sets NODE_ENV based on how you run the app:
#   - 'next dev'   -> NODE_ENV=development
#   - 'next start' -> NODE_ENV=production
#   - 'next test'  -> NODE_ENV=test
# You typically do NOT need to set this manually in .env.local.
# ------------------------------------------------------------------------------
# NODE_ENV=development
