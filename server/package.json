{
  "name": "bookmystudio-server",
  "version": "1.0.0",
  "description": "BookMyStudio Backend API Server (Express + MongoDB + Mongoose)",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/utils/seed.ts",
