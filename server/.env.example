# ==============================================================================
# BookMyStudio - Backend Server Environment Configuration (.env.example)
# ==============================================================================
# This file documents all environment variables used by the Express + MongoDB
# backend API server located in 'server/'.
#
# QUICK START FOR LOCAL DEVELOPMENT:
#   1. Copy this file to 'server/.env':
#        cp server/.env.example server/.env
#   2. The defaults below allow the backend to start immediately in development
#      using a local MongoDB instance ('mongodb://127.0.0.1:27017/bookmystudio')
#      and simulated email/SMS OTP dispatch in the server console.
#
# FILE LOADING ORDER:
#   The server checks candidates in order:
#     1. server/.env
#     2. .env (in workspace root)
#     3. ../../.env (relative to dist/config)
#
# SECURITY REQUIREMENTS:
#   - NEVER commit real credentials, database passwords, or secret keys to git.
#   - Ensure 'server/.env' and '.env' are listed in your .gitignore file.
#   - In production, set all [REQUIRED IN PRODUCTION] variables with high-entropy
#     cryptographically random secrets and production service credentials.
# ==============================================================================

# ==============================================================================
# 1. SERVER & RUNTIME
# ==============================================================================

# PORT
# Purpose:  TCP port for the Express HTTP server to listen on.
# Status:   OPTIONAL (Defaults to 4000 if unset)
# Format:   Positive integer (e.g., 4000, 8080)
PORT=4000

# NODE_ENV
# Purpose:  Runtime execution environment mode. Controls error stack traces,
#           session cookie security flags (Secure, SameSite), and mock fallbacks.
# Status:   OPTIONAL in development (defaults to 'development');
#           REQUIRED to be 'production' in production deployments.
# Values:   'development' | 'production' | 'test'
NODE_ENV=development

# CLIENT_ORIGIN
# Purpose:  The canonical URL of the frontend web application. Used by CORS
#           middleware to whitelist requests with 'credentials: true' and allow
#           session cookies to be read across origins.
# Status:   REQUIRED IN PRODUCTION (Must match the production frontend URL)
# Default:  http://localhost:3000
# Format:   Full URL without trailing slash (e.g., https://bookmystudio.com)
CLIENT_ORIGIN=http://localhost:3000

# ==============================================================================
# 2. DATABASE (MONGODB)
# ==============================================================================

# MONGODB_URI
# Purpose:  Primary MongoDB connection string for Mongoose models and the
#           Connect-Mongo session storage engine.
# Status:   REQUIRED IN PRODUCTION (Atlas or self-hosted replica set with auth)
# Default:  mongodb://127.0.0.1:27017/bookmystudio
# Format:
#   - Local Dev:     mongodb://127.0.0.1:27017/bookmystudio
#   - MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bookmystudio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bookmystudio

# MONGODB_TEST_URI
# Purpose:  Dedicated, isolated database URI used exclusively during automated
#           integration test runs ('pnpm test' or 'NODE_ENV=test').
# Status:   OPTIONAL (If omitted, the test suite automatically derives a test URI
#           by replacing '/bookmystudio' with '/bookmystudio_test')
# Format:   Standard MongoDB URI string pointing to a throwaway test database.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/bookmystudio_test

# ==============================================================================
# 3. AUTHENTICATION, SESSIONS & ACCESS CONTROL
# ==============================================================================

# SESSION_SECRET
# Purpose:  Cryptographic secret key used by express-session to sign the session
#           cookie ('bms_sid'). Prevents cookie tampering and session hijacking.
# Status:   REQUIRED IN PRODUCTION (Must be at least 32 cryptographically random characters)
# Notice:   The server logs a security warning in production if left as the default dev key.
# Tip:      Generate a strong key with: openssl rand -hex 32
SESSION_SECRET=bms_dev_session_secret_32_characters_long_min_production

# ADMIN_EMAILS
# Purpose:  Comma-separated list of superadmin email addresses. Accounts matching
#           these email addresses automatically receive elevated 'admin' role
#           privileges upon registration or when running admin provisioning scripts.
# Status:   OPTIONAL (Defaults to 'raghuveerlinkedin@gmail.com')
# Format:   Comma-separated email addresses without spaces
ADMIN_EMAILS=raghuveerlinkedin@gmail.com

# ==============================================================================
# 4. EMAIL DELIVERY (TRANSACTIONAL SMTP / NODEMAILER)
# ==============================================================================
# The email service handles customer verification OTPs, password reset links,
# and booking confirmation notifications.
#
# In development:
#   If SMTP_USER or SMTP_PASS is unset, the server operates in SIMULATED mode,
#   logging OTPs and verification tokens directly to the console instead of sending
#   network requests.
# In production:
#   Provide valid SMTP credentials to enable live transactional emails.

# SMTP_HOST
# Purpose:  Hostname of your transactional SMTP mail server.
# Status:   OPTIONAL (Defaults to 'smtp.gmail.com')
# Examples: smtp.gmail.com, smtp.sendgrid.net, smtp.postmarkapp.com, email-smtp.us-east-1.amazonaws.com
SMTP_HOST=smtp.gmail.com

# SMTP_PORT
# Purpose:  Port of the SMTP mail server.
# Status:   OPTIONAL (Defaults to 465)
# Values:   465 (SSL/TLS) or 587 (STARTTLS)
SMTP_PORT=465

# SMTP_USER
# Purpose:  Username or authenticated email address for SMTP dispatch.
# Status:   OPTIONAL in Dev (Enables console simulation) / REQUIRED in Production
# Example:  notifications@bookmystudio.com (or your Gmail address)
SMTP_USER=

# SMTP_PASS
# Purpose:  Password or application-specific password for SMTP dispatch.
# Status:   OPTIONAL in Dev (Enables console simulation) / REQUIRED in Production
# Note:     For Gmail, generate a 16-character App Password at:
#           https://myaccount.google.com/apppasswords
SMTP_PASS=

# SMTP_FROM
# Purpose:  The 'From' display name and sender address on outgoing transactional emails.
# Status:   OPTIONAL (Defaults to 'BookMyStudio <no-reply@bookmystudio.com>')
# Format:   "Display Name <email@domain.com>"
SMTP_FROM="BookMyStudio <no-reply@bookmystudio.com>"

# ==============================================================================
# 5. PHONE OTP & SMS GATEWAY
# ==============================================================================
# Handles two-factor authentication and phone number verification.

# SMS_PROVIDER
# Purpose:  Selects the active SMS delivery provider.
# Status:   OPTIONAL (Defaults to 'mock')
# Values:
#   - 'mock':   Simulates SMS in console logs (Default; recommended for development & CI)
#   - 'msg91':  India DLT-compliant SMS gateway
#   - 'twilio': International SMS gateway
SMS_PROVIDER=mock

# --- MSG91 CONFIGURATION (India DLT Compliant Gateway) ---
# Required if SMS_PROVIDER='msg91':
# SMS_API_KEY:      AuthKey from MSG91 dashboard (e.g., 389274A...)
# SMS_SENDER_ID:    6-character approved DLT Sender ID (e.g., BMSOTP)
# SMS_TEMPLATE_ID:  DLT-approved flow/template ID for transactional OTP
SMS_API_KEY=
SMS_SENDER_ID=BMSOTP
SMS_TEMPLATE_ID=

# --- TWILIO CONFIGURATION (International Gateway) ---
# Required if SMS_PROVIDER='twilio':
# TWILIO_ACCOUNT_SID:   Twilio Account SID (starts with 'AC...')
# TWILIO_AUTH_TOKEN:    Twilio Auth Token from console
# TWILIO_FROM_NUMBER:   Twilio phone number in E.164 format (+1...)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==============================================================================
# 6. GEOCODING & MAPS PROXY
# ==============================================================================

# GOOGLE_MAPS_SERVER_API_KEY
# Purpose:  Server-side Google Maps Geocoding and Places API key used by the backend
#           proxy to normalize studio/location addresses and resolve GPS coordinates.
# Status:   OPTIONAL (Address fallback geocoding operates on city/state if omitted)
# Security: Restrict this key in Google Cloud Console to backend server IP addresses.
GOOGLE_MAPS_SERVER_API_KEY=

# ==============================================================================
# 7. PAYOUT VAULT & MARKETPLACE PAYMENTS (RAZORPAY ROUTE)
# ==============================================================================

# PAYOUT_ENCRYPTION_SECRET
# Purpose:  32-character AES-256 encryption key used to encrypt and decrypt sensitive
#           partner bank account numbers, IFSC codes, and payout credentials at rest.
# Status:   OPTIONAL in Dev / RECOMMENDED in Production
# Format:   At least 32 cryptographically random characters
# Tip:      Generate with: openssl rand -hex 16
PAYOUT_ENCRYPTION_SECRET=bms_payout_vault_key_minimum_32_characters_random

# RAZORPAY_ROUTE_ENABLED
# Purpose:  Toggles Razorpay Route marketplace payment split functionality.
# Status:   OPTIONAL (Defaults to 'false')
# Values:   'true' | 'false'
RAZORPAY_ROUTE_ENABLED=false

# RAZORPAY_KEY_ID
# Purpose:  Razorpay API Key ID for processing customer payments and payouts.
# Status:   OPTIONAL in Dev / REQUIRED if RAZORPAY_ROUTE_ENABLED=true
# Format:   rzp_test_... (Sandbox) or rzp_live_... (Production)
RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET
# Purpose:  Razorpay API Key Secret associated with RAZORPAY_KEY_ID.
# Status:   OPTIONAL in Dev / REQUIRED if RAZORPAY_ROUTE_ENABLED=true
RAZORPAY_KEY_SECRET=

# RAZORPAY_WEBHOOK_SECRET
# Purpose:  Secret used to verify cryptographic HMAC signatures on incoming Razorpay webhooks.
# Status:   OPTIONAL in Dev / REQUIRED for live webhook signature verification
RAZORPAY_WEBHOOK_SECRET=

# ==============================================================================
# 8. DATABASE SEEDING SAFETY GUARD
# ==============================================================================

# CONFIRM_SEED
# Purpose:  Safety flag required when executing the seed script ('pnpm server:seed')
#           against a production database (NODE_ENV=production). Prevents accidental
#           database wipes or test data injection in production.
# Status:   OPTIONAL (Defaults to 'false')
# Values:   'true' | 'false'
CONFIRM_SEED=false
